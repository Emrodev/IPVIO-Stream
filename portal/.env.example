# Porta do servidor
PORT=3000

# Credenciais de acesso ao Painel de Administração
ADMIN_USER=admin
ADMIN_PASS=admin123

# Chave de segurança para API / Tokens
ADMIN_KEY=admin123
SESSION_SECRET=ipvio-stream-secret-token-key-2026

# Tipo de banco de dados: 'sqlite' ou 'postgres'
DB_TYPE=sqlite

# Caminho do arquivo SQLite (se DB_TYPE=sqlite)
SQLITE_PATH=./data/portal.db

# String de conexão PostgreSQL (se DB_TYPE=postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ipvio_portal
